# JendCore environment variables
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local — they contain secrets.

# ─── Supabase (public, browser-safe) ───────────────────────────────
# These values are safe to expose to the client. They identify your
# Supabase project and enforce Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ─── TURN relay (optional, public, browser-safe) ────────────────────
# Optional. When unset, calls use Google STUN only, which works on most home
# networks but can fail behind strict or symmetric NATs. Provide a comma-separated
# list of TURN URLs and the username/credential issued by your TURN provider
# (for example Metered or Twilio) to enable the relay. Leave these blank rather
# than inventing credentials — a wrong TURN entry is worse than none.
# Consumed by buildIceServers() in src/hooks/usePeerConnection.ts.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ─── Paystack (server-side ONLY) ───────────────────────────────────
# Used by Vercel Serverless Functions for payment verification.
# MUST NOT be prefixed with VITE_ — keep server-side.
PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME

# ─── Application configuration ─────────────────────────────────────
# Price in smallest currency unit (kobo for NGN, cents for USD).
VITE_LICENSE_PRICE_NGN=0
VITE_LICENSE_PRICE_USD=0
VITE_TRIAL_DAYS=7
